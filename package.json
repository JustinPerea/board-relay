{
  "name": "board-relay",
  "version": "0.1.0",
  "description": "Wake the right agent when a Vercel Board thread or handoff needs it. A relay, a posting guard and a theme for vb serve.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.20"
  },
  "bin": {
    "board-relay": "./bin/board-relay.mjs",
    "agent-board": "./bin/agent-board.mjs"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "examples",
    "board-relay.example.json",
    "README.md",
    "docs/reference.md",
    "docs/recipes.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-timeout=120000 test/*.test.mjs"
  },
  "dependencies": {
    "@vercel/board": "0.56.1"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
